{
  "expo": {
    "name": "Cosmos",
    "slug": "cosmos-mobile",
    "version": "0.2.79",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cosmos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sh.zeron.mobile",
      "buildNumber": "1",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the pairing QR shown by Cosmos on your desktop, and attach photos to a session.",
        "NSPhotoLibraryUsageDescription": "Attach photos from your library to a session.",
        "NSLocalNetworkUsageDescription": "Find Cosmos desktops on this network to connect to them directly."
      }
    },
    "android": {
      "package": "sh.zeron.mobile",
      "versionCode": 2079,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F7",
          "dark": { "backgroundColor": "#0B0B0C" }
        }
      ],
      "expo-secure-store",
      "expo-live-activity",
      "./plugins/with-scene-lifecycle.js",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing QR shown by Cosmos on your desktop."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
