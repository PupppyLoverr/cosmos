/target
# Built distributables live here on the build machine (large binaries — not
# committed; reproduce with scripts/package-linux-cosmos.sh and Gradle).
/artifacts/
**/*.rs.bk
# Local-only scratch space — holds signing/notary credentials, never commit.
/ignore/
*.pdb
.DS_Store
.env
.env.local
node_modules
.wrangler
build/
edge/dist/
# Machine-specific linker config (absolute toolchain paths differ per box).
/.cargo/
.agents
.claude
CLAUDE.md

# Build outputs and local-only artifacts — never commit.
target/
*/target/
*.exe
*.msi
# Nested build dirs only: root /dist holds packaging assets, do not ignore it.
*/dist/
.next/
releases/
*.log
.env.*
