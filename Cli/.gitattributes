# Contract artifacts are compared byte-for-byte across harnesses
# (zcli include_str!, zagy go:embed, zdev text import, conformance C1).
# core.autocrlf=true would check them out as CRLF on Windows and silently
# break that guarantee — pin LF on every checkout.
contracts/tools.json  text eol=lf
go-ssh/tools.json     text eol=lf
zdev/tools.json       text eol=lf
go-ssh/system.txt     text eol=lf
CONTRACT.md           text eol=lf

# Session logs and golden traces are JSONL — one event per LF-terminated line.
*.jsonl               text eol=lf
