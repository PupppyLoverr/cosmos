{
  "name": "zdev",
  "version": "0.1.0",
  "description": "Cosmos CLI — TypeScript/bun harness (contract v1). Ink+React TUI, single compiled binary.",
  "type": "module",
  "bin": {
    "zdev": "./src/cli.tsx"
  },
  "scripts": {
    "start": "bun run src/cli.tsx",
    "build": "bun build --compile src/cli.tsx --outfile dist/zdev",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@xterm/headless": "^6.0.0",
    "typescript": "^5.7.2"
  }
}
